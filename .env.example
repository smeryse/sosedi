# Public application URL.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3002
APP_URL=http://127.0.0.1:3002

# Enables sample product data in local development. Authentication is still enforced.
NEXT_PUBLIC_DEMO_MODE=false

# Standalone PostgreSQL. Keep all values in this section server-only.
DATABASE_URL=postgresql://sosedi:sosedi@127.0.0.1:5432/sosedi
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_APPLICATION_NAME=sosedi-web

# Generate long independent random values and keep them stable across deploys.
AUTH_PASSWORD_PEPPER=
AUTH_RATE_LIMIT_SECRET=

# Optional transactional-email webhook used for password reset links.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# NVIDIA NIM Integration (Server-only credentials & configuration)
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RETRIEVAL_BASE_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_RERANK_MODEL=nvidia/rerank-qa-mistral-4b
NVIDIA_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety
NVIDIA_BNR_GRPC_TARGET=grpc.nvcf.nvidia.com:443
NVIDIA_BNR_FUNCTION_ID=180da92c-fbce-4279-8588-46637ef69989

# Legacy NVIDIA integrations are kept in code but disabled by default.
NVIDIA_AI_ENABLED=false
NVIDIA_EMBEDDINGS_ENABLED=false
NVIDIA_RERANK_ENABLED=false
NVIDIA_SAFETY_ENABLED=false
NVIDIA_BNR_ENABLED=false
NVIDIA_ASR_ENABLED=false
NVIDIA_OCR_ENABLED=false

# Limits & Circuit Breaker
NVIDIA_REQUEST_TIMEOUT_MS=12000
NVIDIA_MAX_RETRIES=2
NVIDIA_RATE_LIMIT_PER_MIN=60

# Local OpenAI-compatible endpoint (Ollama is supported).
# A deterministic response is used only when LOCAL_AI_ENABLED=false.
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_API_KEY=
LOCAL_AI_CHAT_MODEL=qwen3.5:9b
LOCAL_AI_GUARD_MODEL=llama-guard3:8b
LOCAL_AI_EMBED_MODEL=nomic-embed-text
LOCAL_AI_RERANK_MODEL=bge-reranker-v2-m3
LOCAL_AI_REQUEST_TIMEOUT_MS=15000
LOCAL_AI_MAX_RETRIES=2
LOCAL_AI_RETRY_DELAY_MS=150
LOCAL_AI_CIRCUIT_FAILURE_THRESHOLD=3
LOCAL_AI_CIRCUIT_RESET_MS=30000

# S3-compatible private object storage.
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_AVATARS=sosedi-avatars
S3_BUCKET_PROPERTY_IMAGES=sosedi-property-images
S3_BUCKET_MESSAGE_ATTACHMENTS=sosedi-message-attachments
S3_BUCKET_DOCUMENTS=sosedi-documents
S3_BUCKET_CONTRACTS=sosedi-contracts

# Used by scripts/seed-demo-accounts.ts
DEMO_EMAIL_DOMAIN=demo.sosedi.local
DEMO_USER_PASSWORD=DemoSosedi2026!
DEMO_ANNA_EMAIL=anna.demo@sosedi.local
DEMO_ZHENYA_EMAIL=zhenya.demo@sosedi.local
DEMO_MARIA_EMAIL=maria.demo@sosedi.local
DEMO_OWNER_EMAIL=owner.demo@sosedi.local
