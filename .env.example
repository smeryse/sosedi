# Public Supabase values (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never expose these in NEXT_PUBLIC_ variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI is optional. Without a key the app uses the deterministic mock provider.
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Used only by scripts/create-demo-users.ts
DEMO_EMAIL_DOMAIN=demo.sosedi.local
DEMO_USER_PASSWORD=
