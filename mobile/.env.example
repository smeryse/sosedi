# Public Supabase values (safe for the Expo client bundle via EXPO_PUBLIC_*)
# The anon key ONLY respects RLS — already protected by Supabase policies.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to true to keep using local mock data with no sign-in (matches web NEXT_PUBLIC_DEMO_MODE).
EXPO_PUBLIC_DEMO_MODE=false
